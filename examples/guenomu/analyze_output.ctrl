[ TEMPLATE control file for guenomu: everything inside squared brackets is treated as a comment (can span several lines.
  Some options are not used -- still experimental, like some from mini_sampler -- and other you don't want to change.
  Just as a mnemonic, I like to write double (or floats) as in C code, with a dot "." to remind myself of its usage. ]

[ action to be executed by guenomu: start a new sampling of posterior distribution, continue a previously
  started sampling or analyze the posterior samples, summarizing them ]
param_execute_action = anal [ "start", "continue", "prior", "simulat", "importance" or "analyze" ("analise" is also valid); defaults to "start" ]

[ mean value for lambda penalty parameters (scaled s.t. < 1). Follow exponential. ] 
param_reconciliation_prior = 0.000001  [ <double> ] [should be very small values -- much smaller than one] 
[distances to be used, in order: Ndups, Nlosses, Ndeepcoals, RF dist, Hdist, Hdist_discounted, SPR dist ]
param_use_distances = 1111000 [ string with seven one's and zeroes, like 0000001 means only SPR ]

[ number of iterations for the burnin and for the posterior sampling (after burnin) ]
param_n_generations = 10 10000 [ <integer> <integer> ]
[ how many samples should be saved ]
param_n_samples = 500           [ <integer> ]
[ how many times a progress report should appear on screen ] 
param_n_output = 4              [ <integer> ]
[ number of MCMC iterations within aux gene tree sampling -- that is, for the exchange algorithm ]
[ leaving it at zero means that you don't care about the normalization constant -- good approximation unless you're
  using just one or two distances, or if you are care about precise credible intervals...]
param_n_mc_samples = 0           [<integer>]
[ Simulated annealing: number of samples (cycles), number of iterations per sample, and (inverse) initial and final temperatures]
[ parameters for initial simulated annealing: how many cycles, number of iterations per cycle, initial (inverse) temperature and final (inverse) temperature ]
param_anneal = 10 1000 0.5 10  [<eger> <integer> <double> <double>]

[ name of file containing a list of tree filenames ]
param_file_with_tree_files =list_of_trees.txt [ <filename> ]
[ name of file containing names of species ]
param_file_with_species_names = list_of_species.txt [ <filename> ]

     [ you probably don't want to change the next 4 parameter sets ]
[ (inverse) temperature and number of cycles for heated mini-sampler and for Multiple Try Metropolis ]
param_mini_sampler = 0.8 5 4     [ <double> <integer> <integer> ] 
[ perturbation factor for proposal of float values ]
param_perturbation = 1           [ <double> ]
[ initial seed for the random number generator (used only if larger than zero) ]
param_random_number_seed = 0     [ <integer between 1 and 18446744073709551615> ]
[ hexadecimal numbers asked by the program (used only if other parameters are too exotic) ]
param_magic_number = 0           [ <integer> ]



end_of_control_file [ this keyword makes the program skip everything below this line ] 



begin_list_of_alignment_files        [ alignment files with gene families ]
  test_d1.nexus 
end_of_list [ of alignment files ]   [ <<this command must be in separate line>> ] 

begin_list_of_tree_files        [ nexus files with initial trees of gene families and possibly species tree as last one]
  test_1.tre 
end_of_list [ of tree files ]   [ <<this command must be in separate line>> ] 

begin_list_of_checkpoint_files       [ files generated by guenomu with samples in binary format ] 

end_of_list [ of checkpoint files ]  [ <<this command must be in separate line>> ] 

[ name of file containing a list of (binary) checkpoint filenames ] 
file_with_checkpoint_files = [ <filename> ]

[ name of file containing a list of alignment filenames ]
param_file_with_alignment_files = list_of_align.txt [ <filename> ]

begin_list_of_species_names          [ names of species. Should be found within equivalent gene names ]
  SP1 SP2 SP3 SP4 SP5
end_of_list [ of species names ]     [ <<this command must be in separate line>> ] 

[ experimental features below ]

[ type of sequence - only DNA is accepted at the moment ]
param_sequence_type = dna        [ "dna" or "codon" ] 
[ number of categories for the discretized average substitution rates ] 
param_rates_ncat = 2             [ <integer> ]
[ prior mu (mean) and rho (coefficient variation) for the substitution rates ]
param_rates_prior = 1. 1.        [ <double> <double> ]
[ concentration parameter for the Dirichlet mixture -- low values force only one distance, higher values allow for several distances ]
param_mixture_concentration = 1.     [ <double> ] [should be larger than one, to allow for an actual mixture ]

